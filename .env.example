# Required: database and authentication
# URL-encode special characters in the MongoDB username/password.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TRUST_HOST=true
NEXTAUTH_URL=https://your-domain.example
NEXT_PUBLIC_APP_URL=https://your-domain.example
NODE_ENV=production

# Required only when running the initial admin seed
ADMIN_EMAIL=admin@your-domain.example
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Administrator

# Required for profile/document/image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: used as an alternative to the three Cloudinary variables above
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Optional integrations
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_GEOCODING_API_KEY=
NEXT_PUBLIC_CLOUDINARY_REPORT_LOGO_URL=

# Web Push notifications (generate with `npx web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.example

# Build/runtime metadata
DEPLOYMENT_VERSION=
PORT=3000
APP_PORT=3000
CHROME_PATH=

# Optional writable directories. Prefer Cloudinary/persistent storage on Hostinger.
BLUEPRINT_UPLOAD_DIR=
DOCUMENT_TEMPLATE_IMAGE_UPLOAD_DIR=
DIRECT_STOCK_PURCHASE_PHOTO_UPLOAD_DIR=
DO_ARRIVAL_PHOTO_UPLOAD_DIR=
PROJECT_PROGRESS_UPLOAD_DIR=
TICKET_UPLOAD_DIR=
USER_PROFILE_UPLOAD_DIR=

# Migration only: never set these for normal production runtime
POSTGRES_SOURCE_URL=
