generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

// Project lifecycle and planning.
enum ProjectStatus {
  PENDING_SETUP
  RUNNING
  PENDING
  ON_PROGRESS
  TERHAMBAT
  DONE
  // Retained for compatibility with existing project records.
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectPolygonType {
  PROJECT
  SURVEY
}

enum CalendarEventType {
  PROJECT
  MEETING
  DEADLINE
  DELIVERY
  OTHER
}

enum CalendarEventFormat {
  VIRTUAL
  HYBRID
  IN_PERSON
}

enum HabitFrequency {
  DAILY
  WEEKDAYS
  WEEKENDS
}

enum WorkTaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum RequestStatus {
  PENDING_KOORDINATOR
  PENDING_KEUANGAN
  PENDING_LOGISTIK
  ON_DELIVERY
  COMPLETED
  REJECTED
}

// Inventory, procurement, payment, and delivery.
enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum DirectStockPurchaseStatus {
  PENDING_RECEIPT
  RECEIVED
}

enum EquipmentStatus {
  READY
  IN_USE
  MAINTENANCE
  BROKEN
}

enum VehicleFuelSource {
  SPBU
  RETAIL
}

enum VehicleFuelRequestStatus {
  PENDING_FINANCE
  FUNDED
  REJECTED
  PROOF_SUBMITTED
  COMPLETED
}

enum TicketType {
  MATERIAL
  COST
  OPERATIONAL
}

enum TicketRequestCategory {
  OPS
  MATERIAL
  WAREHOUSE
  OFFICE
  FIELD
  APH
  REIMBURSEMENT
  KASBON
  OPERATING_EXPENSE
  SHIPPING_COST
}

enum TicketFieldCategory {
  HAULING
  LABOR
  DIRECT_STORE
}

enum TicketStatus {
  DRAFT
  PENDING_DIRECTOR
  APPROVED_DIR
  PROCESSED_FINANCE
  PROCESSED_LOGISTIC
  ASSIGNED_TO_MOVER
  IN_TRANSIT
  WAITING_FINANCE_PAYMENT
  COMPLETED
  REJECTED
}

enum TicketCategoryHint {
  WAREHOUSE
  PURCHASE
}

enum FulfillmentStatus {
  PENDING
  PROCESSED_TO_DO
  PROCESSED_TO_PO
}

enum TicketFulfillmentStatus {
  PENDING
  PARTIALLY_FULFILLED
  COMPLETED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Documents, signatures, and subcontract approvals.
enum OperationalDocumentKind {
  PURCHASE_ORDER
  DELIVERY_ORDER
  CUSTOM
}

enum OperationalDocumentStatus {
  SIGNED
  ISSUED
}

enum DocType {
  INVOICE
  PURCHASE_ORDER
  DO
  SPK
  SURAT_JALAN
  BAST
}

enum POStatus {
  DRAFT
  PENDING_FINANCE_REVIEW
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum PaymentType {
  DOWN_PAYMENT
  PROGRESS_PAYMENT
  FULL_PAYMENT
}

enum PaymentStatus {
  PENDING
  PAID
  REJECTED
}

enum POPaymentMethod {
  CASH
  TRANSFER
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  APPROVAL
}

enum DOStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  RETURNED
}

enum DODeliveryMethod {
  INTERNAL_MOVER
  EXPEDITION
}

enum BlueprintCategory {
  SHOP_DRAWING
  AS_BUILT
  ARCHITECTURAL
  STRUCTURAL
  MEP
}

enum BlueprintStatus {
  DRAFT
  FOR_APPROVAL
  APPROVED_FOR_CONSTRUCTION
  REVISED
  REJECTED
}

enum SPKStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  COMPLETED
  TERMINATED
  REJECTED
}

enum SubkonTermynStatus {
  SUBMITTED
  FIELD_VERIFIED
  FINANCE_CHECKED
  PENDING_APPROVAL
  APPROVED
  PAID
  REJECTED
}

enum ProjectAddendumStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum BASTType {
  PHO
  FHO
}

enum UserRole {
  DIRECTOR        @map("DIRECTUR")
  DEPUTY_DIRECTOR @map("WAKIL_DIRECTUR")
  DRAFTER
  FINANCE         @map("KEUANGAN")
  LOGISTICS       @map("KOORDINATOR_LOGISTIK")
  KOORDINATOR     @map("KOORDINATOR_LAPANGAN")
  FIELD_TEAM      @map("TIM_LAPANGAN")
  MOVER
  ADMINISTRATIONS @map("ADMIN")

  @@map("Role")
}

model MenuAccess {
  id        String   @id @default(cuid()) @map("_id")
  role      String
  menuKey   String
  menuName  String
  isAllowed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, menuKey])
  @@map("MenuAccess")
}

model PageMaintenance {
  pageKey            String   @id @map("_id")
  pageName           String
  path               String
  isUnderMaintenance Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("PageMaintenance")
}

// Identity, access, and user-owned records.
model User {
  id                                                String                        @id @default(cuid()) @map("_id")
  name                                              String
  email                                             String                        @unique
  phone                                             String?
  profilePhotoUrl                                   String?
  bankName                                          String?
  bankAccountName                                   String?
  bankAccountNumber                                 String?
  passwordHash                                      String                        @map("password")
  role                                              UserRole                      @default(FIELD_TEAM)
  isActive                                          Boolean                       @default(true)
  lastLoginAt                                       DateTime?
  createdAt                                         DateTime                      @default(now())
  updatedAt                                         DateTime
  CalendarEvent                                     CalendarEvent[]
  notes                                             UserNote[]
  MaterialRequest_MaterialRequest_approverIdToUser  MaterialRequest[]             @relation("MaterialRequest_approverIdToUser")
  MaterialRequest_MaterialRequest_requesterIdToUser MaterialRequest[]             @relation("MaterialRequest_requesterIdToUser")
  Session                                           Session[]
  tickets                                           Ticket[]
  processedPaymentTransactions                      PaymentTransaction[]          @relation("PaymentTransactionProcessor")
  approvedDirectStockPurchases                      DirectStockPurchase[]         @relation("DirectStockPurchaseApprover")
  uploadedDirectStockPurchaseInvoices               DirectStockPurchase[]         @relation("DirectStockPurchaseInvoiceUploader")
  ticketAuditLogs                                   TicketAuditLog[]
  assignedProjects                                  Project[]                     @relation("ProjectFieldPic")
  fieldSurveys                                      FieldSurvey[]                 @relation("FieldSurveyor")
  proposedWorkPointWages                            ProjectWorkPoint[]            @relation("WorkPointWageProposer")
  approvedWorkPointWages                            ProjectWorkPoint[]            @relation("WorkPointWageApprover")
  draftedBlueprints                                 Blueprint[]                   @relation("BlueprintDrafter")
  reviewedBlueprints                                Blueprint[]                   @relation("BlueprintReviewer")
  uploadedDrawingDocuments                          DrawingDocument[]             @relation("DrawingUploader")
  createdDrawingLogs                                DrawingLog[]                  @relation("DrawingLogCreator")
  createdSubkonContracts                            SubkonContract[]              @relation("SubkonContractCreator")
  approvedSubkonContracts                           SubkonContract[]              @relation("SubkonContractApprover")
  createdSubkonTermyns                              SubkonTermyn[]                @relation("SubkonTermynCreator")
  verifiedSubkonTermyns                             SubkonTermyn[]                @relation("SubkonTermynFieldVerifier")
  reviewedSubkonTermyns                             SubkonTermyn[]                @relation("SubkonTermynFinanceReviewer")
  approvedSubkonTermyns                             SubkonTermyn[]                @relation("SubkonTermynApprover")
  paidSubkonTermyns                                 SubkonTermyn[]                @relation("SubkonTermynPayer")
  createdProjectAddendums                           ProjectAddendum[]             @relation("ProjectAddendumCreator")
  approvedProjectAddendums                          ProjectAddendum[]             @relation("ProjectAddendumApprover")
  approvedBASTDocuments                             BASTDocument[]                @relation("BASTApprover")
  createdEquipmentLogs                              EquipmentLog[]                @relation("EquipmentLogCreator")
  createdVehicleTripLogs                            VehicleTripLog[]              @relation("VehicleTripLogCreator")
  vehicleFuelRequests                               VehicleFuelRequest[]          @relation("VehicleFuelRequester")
  reviewedVehicleFuelRequests                       VehicleFuelRequest[]          @relation("VehicleFuelReviewer")
  releasedSubkonRetentions                          SubkonContract[]              @relation("SubkonContractRetentionReleaser")
  habits                                            Habit[]
  createdWorkTasks                                  WorkTask[]                    @relation("WorkTaskCreator")
  assignedWorkTasks                                 WorkTask[]                    @relation("WorkTaskAssignee")
  workTaskMemberships                               WorkTaskMember[]
  timesheetEntries                                  TimesheetEntry[]
  calendarReminders                                 CalendarEventReminder[]
  calendarEventParticipants                         CalendarEventParticipant[]
  createdDocumentTemplates                          OperationalDocumentTemplate[] @relation("DocumentTemplateCreator")
  createdPurchaseOrders                             PurchaseOrder[]               @relation("PurchaseOrderCreator")
  reviewedPurchaseOrders                            PurchaseOrder[]               @relation("PurchaseOrderReviewer")
  approvedPurchaseOrders                            PurchaseOrder[]               @relation("PurchaseOrderApprover")
  sentPurchaseOrders                                PurchaseOrder[]               @relation("PurchaseOrderVendorSender")
  uploadedPurchaseOrderInvoices                     PurchaseOrder[]               @relation("PurchaseOrderInvoiceUploader")
  createdDeliveryOrders                             DeliveryOrder[]               @relation("DeliveryOrderCreator")
  preparedOperationalDocuments                      OperationalDocument[]         @relation("OperationalDocumentPreparer")
  signedOperationalDocuments                        OperationalDocument[]         @relation("OperationalDocumentSigner")
  issuedOperationalDocuments                        OperationalDocument[]         @relation("OperationalDocumentIssuer")
  issuedDocuments                                   IssuedDocument[]              @relation("IssuedDocumentIssuer")
  assignedMoverTickets                              Ticket[]                      @relation("Ticket_moverAssigneeIdToUser")
  stockPurchases                                    StockPurchase[]               @relation("StockPurchaseCreator")
  createdDirectStockPurchases                       DirectStockPurchase[]         @relation("DirectStockPurchaseCreator")
  receivedDirectStockPurchases                      DirectStockPurchase[]         @relation("DirectStockPurchaseReceiver")
  createdStockMovements                             StockMovement[]               @relation("StockMovementCreator")
  receivedDeliveryOrders                            DeliveryOrder[]               @relation("DeliveryOrderReceiver")
  sentPaymentConfirmations                          PaymentTransaction[]          @relation("PaymentTransactionVendorSender")
  sentOrderConfirmations                            OrderConfirmation[]           @relation("OrderConfirmationVendorSender")
  signedInvoices                                    Invoice[]                     @relation("InvoiceSigner")
  acknowledgedInvoices                              Invoice[]                     @relation("InvoiceAcknowledger")
  signedOrderConfirmations                          OrderConfirmation[]           @relation("OrderConfirmationSigner")
  acknowledgedOrderConfirmations                    OrderConfirmation[]           @relation("OrderConfirmationAcknowledger")
  signedDeliveryOrders                              DeliveryOrder[]               @relation("DeliveryOrderSigner")
  acknowledgedDeliveryOrders                        DeliveryOrder[]               @relation("DeliveryOrderAcknowledger")
  wageAuditLogs                                     WageAuditLog[]                @relation("WageAuditChanger")
  createdProjectWageDisbursements                   ProjectWageDisbursement[]     @relation("ProjectWageDisbursementCreator")
  notifications                                     Notification[]                @relation("UserNotifications")
  cashflowsRecorded                                 Cashflow[]                    @relation("CashflowRecorder")
  officeExpensesReceived                            OfficeExpense[]               @relation("OfficeExpenseRecipient")
  officeExpensesRecorded                            OfficeExpense[]               @relation("OfficeExpenseRecorder")
}

model UserNote {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  color     String   @default("primary")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

model Notification {
  id        String           @id @default(cuid()) @map("_id")
  userId    String
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  actionUrl String?
  createdAt DateTime         @default(now())

  @@index([userId, isRead, createdAt])
}

// Scheduling and collaboration.
model CalendarEvent {
  id              String                     @id @map("_id")
  title           String
  description     String?
  type            CalendarEventType          @default(PROJECT)
  startsAt        DateTime
  endsAt          DateTime?
  projectId       String?
  project         Project?                   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  meetingUrl      String?
  location        String?
  format          CalendarEventFormat        @default(HYBRID)
  allDay          Boolean                    @default(false)
  reminderMinutes Int?
  createdById     String
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime
  User            User                       @relation(fields: [createdById], references: [id], onDelete: Cascade)
  reminders       CalendarEventReminder[]
  participants    CalendarEventParticipant[]

  @@index([projectId, startsAt])
  @@index([createdById, startsAt])
  @@index([startsAt])
}

model CalendarEventReminder {
  id        String        @id @default(cuid()) @map("_id")
  eventId   String
  userId    String
  createdAt DateTime      @default(now())
  event     CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, createdAt])
}

model CalendarEventParticipant {
  id        String        @id @default(cuid()) @map("_id")
  eventId   String
  userId    String
  createdAt DateTime      @default(now())
  event     CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, eventId])
}

model MaterialRequest {
  id                                     String        @id @map("_id")
  title                                  String
  description                            String?
  estimatedCost                          BigInt?
  status                                 RequestStatus @default(PENDING_KOORDINATOR)
  requesterId                            String
  approverId                             String?
  fundsApprovedAt                        DateTime?
  fundsDisbursedAt                       DateTime?
  purchasedAt                            DateTime?
  deliveredAt                            DateTime?
  createdAt                              DateTime      @default(now())
  updatedAt                              DateTime
  User_MaterialRequest_approverIdToUser  User?         @relation("MaterialRequest_approverIdToUser", fields: [approverId], references: [id])
  User_MaterialRequest_requesterIdToUser User          @relation("MaterialRequest_requesterIdToUser", fields: [requesterId], references: [id])
  RequestItem                            RequestItem[]

  @@index([requesterId, createdAt])
  @@index([status, createdAt])
}

model RequestItem {
  id              String          @id @map("_id")
  materialName    String
  quantity        Int
  unit            String
  requestId       String
  MaterialRequest MaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model Session {
  id        String   @id @map("_id")
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId, expiresAt])
}

model VerificationToken {
  identifier String   @id @map("_id")
  token      String   @unique
  expires    DateTime
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([expires])
}

// Personal productivity and time tracking.
model Habit {
  id          String            @id @default(cuid()) @map("_id")
  userId      String
  title       String
  description String?
  frequency   HabitFrequency    @default(DAILY)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  User        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions HabitCompletion[]

  @@index([userId, createdAt])
}

model HabitCompletion {
  id          String   @id @default(cuid()) @map("_id")
  habitId     String
  date        DateTime
  completedAt DateTime @default(now())
  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([date])
}

model WorkTask {
  id          String           @id @default(cuid()) @map("_id")
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  status      WorkTaskStatus   @default(TODO)
  color       String           @default("blue")
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creatorId   String
  creator     User             @relation("WorkTaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?            @relation("WorkTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  members     WorkTaskMember[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([projectId, startsAt, endsAt])
  @@index([assigneeId, startsAt])
}

model WorkTaskMember {
  id         String   @id @default(cuid()) @map("_id")
  workTaskId String
  userId     String
  createdAt  DateTime @default(now())
  workTask   WorkTask @relation(fields: [workTaskId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workTaskId, userId])
  @@index([userId, workTaskId])
}

model TimesheetEntry {
  id              String   @id @default(cuid()) @map("_id")
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workDate        DateTime
  durationMinutes Int
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, workDate])
  @@index([projectId, workDate])
}

// Projects, field operations, and progress evidence.
model Project {
  id                  String                    @id @default(cuid()) @map("_id")
  code                String                    @unique
  name                String
  title               String
  isDeleted           Boolean                   @default(false)
  kelompokTani        String
  address             String
  jenisPekerjaan      String?
  pagu                BigInt
  landArea            BigInt?
  progress            Float                     @default(0)
  priority            ProjectPriority           @default(MEDIUM)
  vendor              String?
  clientName          String?
  location            String?
  status              ProjectStatus             @default(PENDING_SETUP)
  startDate           DateTime?
  endDate             DateTime?
  budget              BigInt?
  fieldPicId          String?
  fieldPic            User?                     @relation("ProjectFieldPic", fields: [fieldPicId], references: [id], onDelete: SetNull)
  fieldSurveys        FieldSurvey[]
  polygons            ProjectPolygon[]
  drawingDocuments    DrawingDocument[]
  dailyReports        DailyReport[]
  workPoints          ProjectWorkPoint[]
  wageDisbursements   ProjectWageDisbursement[]
  stockMovements      StockMovement[]
  tickets             Ticket[]
  calendarEvents      CalendarEvent[]
  workTasks           WorkTask[]
  timesheetEntries    TimesheetEntry[]
  blueprints          Blueprint[]
  subkonContracts     SubkonContract[]
  purchaseOrders      PurchaseOrder[]
  invoices            Invoice[]
  cashflows           Cashflow[]
  equipmentLogs       EquipmentLog[]
  equipmentRentals    EquipmentRental[]
  vehicleTripLogs     VehicleTripLog[]
  vehicleFuelRequests VehicleFuelRequest[]
  addendums           ProjectAddendum[]
  bastDocuments       BASTDocument[]
  materialPlans       ProjectMaterialPlan[]
  rabMaterials        ProjectRabMaterial[]
  laborPlans          ProjectLaborPlan[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([fieldPicId])
}

model FieldSurvey {
  id                String           @id @default(cuid()) @map("_id")
  projectId         String?
  project           Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectName       String
  locationName      String
  responsibleName   String
  surveyorId        String
  surveyor          User             @relation("FieldSurveyor", fields: [surveyorId], references: [id], onDelete: Restrict)
  surveyName        String           @default("Survei Lapangan")
  surveyType        String           @default("REHAB_SAWAH")
  projectCode       String?
  objectCategory    String           @default("Batas Area Proyek (Polygon)")
  vegetationType    String?
  topography        String?
  landOwnership     String?
  documentationUrls String[]         @default([])
  geometryType      String?
  centerCoordinate  String?
  geoJsonData       Json
  areaSqm           Float?
  lengthM           Float?
  perimeterM        Float?
  notes             String?
  generalNotes      String?
  features          SurveyFeature[]
  photos            SurveyPhoto[]
  polygons          ProjectPolygon[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @default(now()) @updatedAt

  @@index([projectId, createdAt])
  @@index([surveyorId, createdAt])
}

model ProjectPolygon {
  id           String             @id @default(cuid()) @map("_id")
  projectId    String
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  surveyId     String?
  survey       FieldSurvey?       @relation(fields: [surveyId], references: [id], onDelete: SetNull)
  type         ProjectPolygonType
  name         String
  geometryType String
  geoJsonData  Json
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([projectId, type])
  @@index([surveyId])
}

model SurveyFeature {
  id              String        @id @default(cuid()) @map("_id")
  surveyId        String
  survey          FieldSurvey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  featureCategory String
  name            String
  description     String?
  geometryType    String
  geoJsonData     Json
  areaSqm         Float?
  lengthM         Float?
  photoUrls       String[]      @default([])
  photos          SurveyPhoto[]
  createdAt       DateTime      @default(now())

  @@index([surveyId, createdAt])
}

model SurveyPhoto {
  id         String         @id @default(cuid()) @map("_id")
  surveyId   String
  survey     FieldSurvey    @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  featureId  String?
  feature    SurveyFeature? @relation(fields: [featureId], references: [id], onDelete: Cascade)
  url        String
  caption    String
  latitude   Float
  longitude  Float
  capturedAt DateTime       @default(now())
  createdAt  DateTime       @default(now())

  @@index([surveyId, createdAt])
  @@index([featureId, createdAt])
}

model DailyReport {
  id             String                 @id @default(cuid()) @map("_id")
  projectId      String
  project        Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workPointId    String?
  workPoint      ProjectWorkPoint?      @relation(fields: [workPointId], references: [id], onDelete: SetNull)
  reportDate     DateTime
  weather        String?
  workersCount   Int                    @default(0)
  progress       Float?
  dailyVolume    Float?
  equipment      Json?
  workSummary    String?
  notes          String?
  k3SafetyLog    String?
  progressPhotos ProjectProgressPhoto[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([projectId, reportDate])
  @@index([reportDate])
}

model ProjectProgressPhoto {
  id            String      @id @default(cuid()) @map("_id")
  dailyReportId String
  dailyReport   DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  url           String      @unique
  fileUrl       String?
  publicId      String?
  createdAt     DateTime    @default(now())

  @@index([dailyReportId, createdAt])
}

model ProjectWorkPoint {
  id                String                     @id @default(cuid()) @map("_id")
  projectId         String
  project           Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title             String
  location          String?
  plannedStartDate  DateTime?
  targetDate        DateTime?
  proposedVolume    BigInt?
  proposedUnit      String?
  proposedUnitPrice BigInt?
  proposedTotalWage BigInt
  approvedTotalWage BigInt?
  wageApprovedAt    DateTime?
  proposedById      String
  proposedBy        User                       @relation("WorkPointWageProposer", fields: [proposedById], references: [id], onDelete: Restrict)
  wageApprovedById  String?
  wageApprovedBy    User?                      @relation("WorkPointWageApprover", fields: [wageApprovedById], references: [id], onDelete: SetNull)
  progress          Float                      @default(0)
  completedVolume   Float?
  dailyReports      DailyReport[]
  progressReports   ProjectWorkPointProgress[]
  wageAuditLogs     WageAuditLog[]
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([projectId, createdAt])
  @@index([proposedById])
}

// Master Bahan dari Upload RAB (analisa / daftar bahan RAB)
model ProjectRabMaterial {
  id        String   @id @default(cuid()) @map("_id")
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  unit      String
  category  String?  @default("BAHAN")
  rabPrice  BigInt?  @default(0)
  quantity  Float?   @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, name])
}

// Bahan RAP yang diisi Tim ADM / Manajer Proyek
model ProjectMaterialPlan {
  id              String   @id @default(cuid()) @map("_id")
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workPointId     String?
  materialName    String
  unit            String
  plannedQuantity Float    @default(0) // Kebutuhan dari analisa RAB
  actualQuantity  Float    @default(0) // Bahan Aktual yang diisi Tim ADM / PM
  unitPrice       BigInt   @default(0) // Harga satuan RAP beli
  totalPrice      BigInt   @default(0) // Total biaya bahan RAP
  scope           String   @default("ALL")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId])
}

// Jasa Borongan RAP ("Untuk Jasa Kita Borongkan")
model ProjectLaborPlan {
  id            String   @id @default(cuid()) @map("_id")
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workPointId   String?  // Id item pekerjaan RAB terkait
  jobName       String   // Uraian pekerjaan borongan
  volume        Float    @default(1)
  unit          String   @default("paket")
  boronganRate  BigInt   @default(0) // Harga borongan per unit
  totalBorongan BigInt   @default(0) // Total upah jasa borongan
