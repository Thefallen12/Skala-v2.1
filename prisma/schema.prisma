  @@index([status, updatedAt])
}

model DrawingLog {
  id          String          @id @default(cuid()) @map("_id")
  drawingId   String
  drawing     DrawingDocument @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  action      String
  notes       String?
  version     Int
  fileUrl     String?
  createdById String
  createdBy   User            @relation("DrawingLogCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime        @default(now())

  @@index([drawingId, createdAt])
}

model ProjectWorkPointProgress {
  id          String                          @id @default(cuid()) @map("_id")
  workPointId String
  workPoint   ProjectWorkPoint                @relation(fields: [workPointId], references: [id], onDelete: Cascade)
  reportDate  DateTime
  progress    Float
  workSummary String?
  photos      ProjectWorkPointProgressPhoto[]
  createdAt   DateTime                        @default(now())

  @@index([workPointId, reportDate])
}

model ProjectWorkPointProgressPhoto {
  id               String                   @id @default(cuid()) @map("_id")
  progressReportId String
  progressReport   ProjectWorkPointProgress @relation(fields: [progressReportId], references: [id], onDelete: Cascade)
  url              String                   @unique
  fileUrl          String?
  publicId         String?
  createdAt        DateTime                 @default(now())

  @@index([progressReportId, createdAt])
}

// Inventory and purchasing.
model StockMovement {
  id           String            @id @default(cuid()) @map("_id")
  projectId    String?
  project      Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  stockItemId  String?
  stockItem    StockItem?        @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  type         StockMovementType
  materialName String
  quantity     BigInt
  totalCost    BigInt?
  unit         String
  occurredAt   DateTime          @default(now())
  reference    String?
  notes        String?
  createdById  String?
  createdBy    User?             @relation("StockMovementCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())

  @@index([projectId, occurredAt])
  @@index([stockItemId, occurredAt])
  @@index([materialName])
}

model StockItem {
  id                  String                    @id @default(cuid()) @map("_id")
  sku                 String                    @unique
  name                String
  category            String                    @default("MATERIAL")
  unit                String
  stockQuantity       BigInt                    @default(0)
  minimumStock        BigInt                    @default(0)
  unitPrice           BigInt                    @default(0)
  purchases           StockPurchase[]
  directPurchaseItems DirectStockPurchaseItem[]
  movements           StockMovement[]
  purchaseOrderItems  POItem[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([name])
  @@map("LogisticsStockItem")
}

model StockPurchase {
  id              String         @id @default(cuid()) @map("_id")
  purchaseNumber  String         @unique
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  stockItemId     String
  stockItem       StockItem      @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  quantity        BigInt
  unitPrice       BigInt
  supplierName    String?
  reference       String?
  notes           String?
  createdById     String
  createdBy       User           @relation("StockPurchaseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime       @default(now())

  @@index([stockItemId, createdAt])
  @@index([createdById, createdAt])
  @@index([purchaseOrderId])
}

model DirectStockPurchase {
  id                        String                    @id @default(cuid()) @map("_id")
  purchaseNumber            String                    @unique
  vendorId                  String?
  vendor                    Vendor?                   @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  ticketId                  String?
  ticket                    Ticket?                   @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  vendorName                String
  paymentMethod             POPaymentMethod           @default(CASH)
  paymentBankName           String?
  paymentAccountNumber      String?
  paymentAccountName        String?
  paymentTerms              String?
  includeTax                Boolean                   @default(false)
  totalAmount               BigInt
  paidAt                    DateTime?
  reference                 String?
  notes                     String?
  status                    DirectStockPurchaseStatus @default(PENDING_RECEIPT)
  isApprovedByDirector      Boolean                   @default(false)
  approvedById              String?
  approvedBy                User?                     @relation("DirectStockPurchaseApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt                DateTime?
  vendorInvoiceUrl          String?
  vendorInvoiceUploadedById String?
  vendorInvoiceUploadedBy   User?                     @relation("DirectStockPurchaseInvoiceUploader", fields: [vendorInvoiceUploadedById], references: [id], onDelete: SetNull)
  vendorInvoiceUploadedAt   DateTime?
  receivedAt                DateTime?
  receivedById              String?
  receivedBy                User?                     @relation("DirectStockPurchaseReceiver", fields: [receivedById], references: [id], onDelete: SetNull)
  arrivalPhotoUrl           String?
  receivedPhotos            String[]                  @default([])
  createdById               String
  createdBy                 User                      @relation("DirectStockPurchaseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items                     DirectStockPurchaseItem[]
  paymentTransactions       PaymentTransaction[]
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt

  @@index([status, createdAt])
  @@index([vendorId, createdAt])
  @@index([ticketId, createdAt])
  @@index([createdById, createdAt])
  @@index([receivedById, receivedAt])
  @@index([isApprovedByDirector, createdAt])
}

model DirectStockPurchaseItem {
  id          String              @id @default(cuid()) @map("_id")
  purchaseId  String
  purchase    DirectStockPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  stockItemId String
  stockItem   StockItem           @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  itemName    String
  unit        String
  quantity    BigInt
  unitPrice   BigInt
  totalPrice  BigInt

  @@index([purchaseId])
  @@index([stockItemId])
}

model Vendor {
  id                   String                @id @default(cuid()) @map("_id")
  code                 String                @unique
  name                 String
  category             String
  address              String?
  phone                String?
  email                String?
  bankName             String?
  bankAccount          String?
  bankHolder           String?
  rating               Float                 @default(5)
  isApproved           Boolean               @default(true)
  purchaseOrders       PurchaseOrder[]
  directStockPurchases DirectStockPurchase[]
  bankAccounts         VendorBankAccount[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([name])
  @@index([category, isApproved])
}

model VendorBankAccount {
  id          String   @id @default(cuid()) @map("_id")
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  label       String?
  bankName    String
  bankAccount String
  bankHolder  String
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([vendorId, isPrimary])
}

// Labor, equipment, and subcontract lifecycle.
model WageAuditLog {
  id          String           @id @default(cuid()) @map("_id")
  workPointId String
  workPoint   ProjectWorkPoint @relation(fields: [workPointId], references: [id], onDelete: Cascade)
  oldWage     BigInt
  newWage     BigInt
  changedById String
  changedBy   User             @relation("WageAuditChanger", fields: [changedById], references: [id], onDelete: Restrict)
  reason      String?
  createdAt   DateTime         @default(now())

  @@index([workPointId, createdAt])
  @@index([changedById, createdAt])
}

model ProjectWageDisbursement {
  id            String   @id @default(cuid()) @map("_id")
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amount        BigInt
  receiptNumber String
  paidAt        DateTime
  notes         String?
  paidById      String
  paidBy        User     @relation("ProjectWageDisbursementCreator", fields: [paidById], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now())

  @@index([projectId, paidAt])
  @@index([paidById, paidAt])
}

model EquipmentMaster {
  id           String          @id @default(cuid()) @map("_id")
  code         String          @unique
  name         String
  brand        String?
  licensePlate String?
  hourlyRate   BigInt          @default(0)
  status       EquipmentStatus @default(READY)
  currentHM    BigInt          @default(0)
  logs         EquipmentLog[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([name])
  @@index([status])
}

model SubkonContract {
  id                       String         @id @default(cuid()) @map("_id")
  publicCode               String         @unique
  contractNumber           String         @unique
  projectId                String
  project                  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subkonName               String
  workScope                String
  contractValue            BigInt
  retentionPct             BigInt         @default(5000)
  status                   SPKStatus      @default(DRAFT)
  createdById              String
  createdBy                User           @relation("SubkonContractCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedById             String?
  approvedBy               User?          @relation("SubkonContractApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt               DateTime?
  retentionReleasedAt      DateTime?
  retentionReleaseProofUrl String?
  retentionReleasedById    String?
  retentionReleasedBy      User?          @relation("SubkonContractRetentionReleaser", fields: [retentionReleasedById], references: [id], onDelete: SetNull)
  termyns                  SubkonTermyn[]
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  @@index([projectId, status])
  @@index([status, createdAt])
}

model SubkonTermyn {
  id                  String             @id @default(cuid()) @map("_id")
  subkonContractId    String
  subkonContract      SubkonContract     @relation(fields: [subkonContractId], references: [id], onDelete: Cascade)
  termynNumber        Int
  claimedPercent      BigInt
  grossAmount         BigInt
  retentionAmount     BigInt
  netAmount           BigInt
  status              SubkonTermynStatus @default(SUBMITTED)
  paymentProofUrl     String?
  createdById         String
  createdBy           User               @relation("SubkonTermynCreator", fields: [createdById], references: [id], onDelete: Restrict)
  fieldVerifiedById   String?
  fieldVerifiedBy     User?              @relation("SubkonTermynFieldVerifier", fields: [fieldVerifiedById], references: [id], onDelete: SetNull)
  fieldVerifiedAt     DateTime?
  financeReviewedById String?
  financeReviewedBy   User?              @relation("SubkonTermynFinanceReviewer", fields: [financeReviewedById], references: [id], onDelete: SetNull)
  financeReviewedAt   DateTime?
  approvedById        String?
  approvedBy          User?              @relation("SubkonTermynApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt          DateTime?
  paidById            String?
  paidBy              User?              @relation("SubkonTermynPayer", fields: [paidById], references: [id], onDelete: SetNull)
  invoice             Invoice?
  paidAt              DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([subkonContractId, termynNumber])
  @@index([status, createdAt])
}

model EquipmentLog {
  id                String           @id @default(cuid()) @map("_id")
  equipmentMasterId String?
  equipmentMaster   EquipmentMaster? @relation(fields: [equipmentMasterId], references: [id], onDelete: SetNull)
  projectId         String
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  equipmentName     String
  operatorName      String?
  date              DateTime
  hmStart           BigInt
  hmEnd             BigInt
  effectiveHours    BigInt
  fuelLiter         BigInt
  notes             String?
  createdById       String
  createdBy         User             @relation("EquipmentLogCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt         DateTime         @default(now())

  @@index([projectId, date])
}

model EquipmentRental {
  id               String   @id @default(cuid()) @map("_id")
  type             String   // EQUIPMENT | VEHICLE
  name             String   // Nama Alat atau Kendaraan
  category         String?  // mis. Alat Berat, Mobil Pick Up, Dump Truck
  codeOrPlate      String?  // Plat nomor / Kode Unit
  vendorName       String   // Pemilik / Vendor Persewaan
  vendorPhone      String?  // Nomor telepon / Kontak vendor
  rentalPeriodType String   // DAILY | WEEKLY | MONTHLY
  startDate        DateTime // Tanggal Mulai
  endDate          DateTime // Tanggal Selesai
  duration         Int      @default(1) // Jumlah hari / minggu / bulan
  ratePerPeriod    BigInt   @default(0) // Tarif sewa per periode (scaled integer)
  additionalCost   BigInt   @default(0) // Biaya mobilisasi / operator dll (scaled integer)
  totalCost        BigInt   @default(0) // Total biaya sewa (scaled integer)
  status           String   @default("ACTIVE") // ACTIVE | COMPLETED | EXTENDED | CANCELLED
  withOperator     Boolean  @default(false)
  operatorName     String?
  withFuel         Boolean  @default(false)
  projectId        String?
  project          Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  notes            String?
  createdById      String?
  createdByName    String?

  // Finance & Billing Connection
  paymentStatus          String    @default("UNPAID") // UNPAID | PENDING_PAYMENT | PAID
  billingSubmittedAt     DateTime?
  billingSubmittedById   String?
  billingSubmittedByName String?
  paidAt                 DateTime?
  paidById               String?
  paidByName             String?
  proofOfPaymentUrl      String?
  paymentBankName        String?
  paymentAccountNumber   String?
  paymentAccountName     String?
  financeNotes           String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([type, status])
  @@index([paymentStatus, billingSubmittedAt])
  @@index([projectId, startDate])
}

// Project approvals, handover, and document numbering.
model ProjectAddendum {
  id             String                @id @default(cuid()) @map("_id")
  projectId      String
  project        Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  addendumNumber String                @unique
  budgetChange   BigInt
  timeExtension  Int
  reason         String
  status         ProjectAddendumStatus @default(DRAFT)
  createdById    String
  createdBy      User                  @relation("ProjectAddendumCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedById   String?
  approvedBy     User?                 @relation("ProjectAddendumApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([projectId, status])
}

model BASTDocument {
  id                String    @id @default(cuid()) @map("_id")
  publicCode        String    @unique
  bastNumber        String    @unique
  projectId         String
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type              BASTType  @default(PHO)
  date              DateTime
  maintenanceEndsAt DateTime?
  notes             String?
  isApproved        Boolean   @default(false)
  approvedById      String?
  approvedBy        User?     @relation("BASTApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt        DateTime?
  createdAt         DateTime  @default(now())

  @@index([projectId, type, isApproved])
}

model DocumentNumberSequence {
  id    String @id @default(cuid()) @map("_id")
  kind  String
  year  Int
  value Int    @default(0)

  @@unique([kind, year])
}

// Ticket intake and fulfillment.
model Ticket {
  id                        String                  @id @default(cuid()) @map("_id")
  ticketNumber              String                  @unique
  title                     String
  description               String?
  type                      TicketType
  priority                  TicketPriority          @default(MEDIUM)
  status                    TicketStatus            @default(DRAFT)
  fulfillmentStatus         TicketFulfillmentStatus @default(PENDING)
  totalAmount               BigInt?
  requestedAmount           Float?
  isApprovedByDirector      Boolean                 @default(false)
  attachmentUrl             String?
  receiptUrls               String[]                @default([])
  paymentProofUrl           String?
  requestCategory           TicketRequestCategory?
  fieldCategory             TicketFieldCategory?
  shippingDetails           Json?
  relatedPoIds              String[]                @default([])
  relatedTicketIds          String[]                @default([])
  requestPaymentMethod      POPaymentMethod?
  requestPaymentDescription String?
  recipientName             String?
  bankName                  String?
  accountNumber             String?
  purchaseReceiptUrl        String?
  transferReceiptUrl        String?
  transferDestination       String?
  deliveryReceiptUrl        String?
  deliveryOrderReceiptUrl   String?
  moverAssigneeId           String?
  requesterId               String
  requester                 User                    @relation(fields: [requesterId], references: [id], onDelete: Restrict)
  moverAssignee             User?                   @relation("Ticket_moverAssigneeIdToUser", fields: [moverAssigneeId], references: [id])
  projectId                 String?
  project                   Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items                     TicketItem[]
  purchaseOrders            PurchaseOrder[]
  directStockPurchases      DirectStockPurchase[]
  paymentTransactions       PaymentTransaction[]
  auditLogs                 TicketAuditLog[]
  operationalDocuments      OperationalDocument[]
  deliveryOrders            DeliveryOrder[]
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  @@index([status, type])
  @@index([status, priority])
  @@index([requesterId])
  @@index([projectId])
  @@index([moverAssigneeId, status])
}

// Purchase orders, delivery orders, and digital documents.
model OperationalDocumentTemplate {
  id          String                  @id @default(cuid()) @map("_id")
  name        String
  kind        OperationalDocumentKind
  title       String
  content     String
  isActive    Boolean                 @default(true)
  createdById String
  createdBy   User                    @relation("DocumentTemplateCreator", fields: [createdById], references: [id], onDelete: Restrict)
  documents   OperationalDocument[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([kind, isActive])
  @@index([createdById])
}

model DocumentTemplate {
  id              String           @id @default(cuid()) @map("_id")
  name            String
  type            DocType
  contentHtml     String
  contentJson     Json?
  variables       String
  issuedDocuments IssuedDocument[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model PurchaseOrder {
  id                        String               @id @default(cuid()) @map("_id")
  publicCode                String               @unique
  poNumber                  String               @unique
  projectId                 String?
  project                   Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  vendorName                String
  paymentMethod             POPaymentMethod      @default(CASH)
  paymentBankName           String?
  paymentAccountNumber      String?
  paymentAccountName        String?
  paymentTerms              String?
  includeTax                Boolean              @default(false)
  transferDestination       String?
  paymentReceiptUrl         String?
  vendorInvoiceUrl          String?
  vendorInvoiceUploadedAt   DateTime?
  vendorInvoiceUploadedById String?
  vendorInvoiceUploadedBy   User?                @relation("PurchaseOrderInvoiceUploader", fields: [vendorInvoiceUploadedById], references: [id], onDelete: SetNull)
  vendorPoSentAt            DateTime?
  vendorPoSentById          String?
  vendorPoSentBy            User?                @relation("PurchaseOrderVendorSender", fields: [vendorPoSentById], references: [id], onDelete: SetNull)
  paidAt                    DateTime?
  status                    POStatus             @default(DRAFT)
  createdById               String?
  createdBy                 User?                @relation("PurchaseOrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  vendorId                  String?
  vendor                    Vendor?              @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  reviewedById              String?
  reviewedBy                User?                @relation("PurchaseOrderReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt                DateTime?
  approvedById              String?
  approvedBy                User?                @relation("PurchaseOrderApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt                DateTime?
  ticketId                  String?
  ticket                    Ticket?              @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  items                     POItem[]
  invoices                  Invoice[]
  confirmations             OrderConfirmation[]
  deliveryOrders            DeliveryOrder[]
  stockPurchases            StockPurchase[]
  paymentTransactions       PaymentTransaction[]
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  @@index([status, updatedAt])
  @@index([ticketId])
  @@index([projectId])
  @@index([createdById])
  @@index([reviewedById])
  @@index([approvedById])
  @@index([vendorId])
}

model PaymentTransaction {
  id                      String               @id @default(cuid()) @map("_id")
  poId                    String?
  po                      PurchaseOrder?       @relation(fields: [poId], references: [id], onDelete: SetNull)
  ticketId                String?
  ticket                  Ticket?              @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  directStockPurchaseId   String?
  directStockPurchase     DirectStockPurchase? @relation(fields: [directStockPurchaseId], references: [id], onDelete: SetNull)
  paymentType             PaymentType
  amount                  Float
  transferDestination     String
  status                  PaymentStatus        @default(PENDING)
  processedById           String?
  processedBy             User?                @relation("PaymentTransactionProcessor", fields: [processedById], references: [id], onDelete: SetNull)
  proofOfTransferUrl      String?
  additionalProofUrls     String[]             @default([])
  paidAt                  DateTime?
  confirmationOrderNumber String?              @unique
  vendorSentAt            DateTime?
  vendorSentById          String?
  vendorSentBy            User?                @relation("PaymentTransactionVendorSender", fields: [vendorSentById], references: [id], onDelete: SetNull)
  orderConfirmation       OrderConfirmation?
  cashflow                Cashflow?
  createdAt               DateTime             @default(now())

  @@index([poId, status, createdAt])
  @@index([ticketId, status, createdAt])
  @@index([directStockPurchaseId, status, createdAt])
  @@index([processedById])
  @@index([vendorSentAt, createdAt])
}

model DeliveryOrder {
  id                    String               @id @default(cuid()) @map("_id")
  publicCode            String               @unique
  doNumber              String               @unique
  ticketId              String?
  ticket                Ticket?              @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  poId                  String?
  po                    PurchaseOrder?       @relation(fields: [poId], references: [id], onDelete: SetNull)
  createdById           String?
  createdBy             User?                @relation("DeliveryOrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  receivedById          String?
  receivedBy            User?                @relation("DeliveryOrderReceiver", fields: [receivedById], references: [id], onDelete: SetNull)
  signedById            String?
  signedBy              User?                @relation("DeliveryOrderSigner", fields: [signedById], references: [id], onDelete: SetNull)
  signedAt              DateTime?
  acknowledgedById      String?
  acknowledgedBy        User?                @relation("DeliveryOrderAcknowledger", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  acknowledgedAt        DateTime?
  deliveryMethod        DODeliveryMethod     @default(INTERNAL_MOVER)
  vehicleId             String?
  vehicle               Vehicle?             @relation("DeliveryOrderVehicle", fields: [vehicleId], references: [id], onDelete: SetNull)
  vehiclePlateNumber    String?
  departureKilometer    BigInt?
  vehicleDocumentNumber String?
  vehiclePlate          String?
  driverName            String?
  driverIdentityNumber  String?
  driverPhone           String?
  receiverName          String?
  receivedAt            DateTime?
  arrivalPhotoUrl       String?
  deliveryReceiptUrl    String?
  receiptPhotos         DeliveryOrderProof[]
  status                DOStatus             @default(PENDING)
  items                 DOItem[]
  vehicleTripLog        VehicleTripLog?
  fuelRequests          VehicleFuelRequest[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([status, updatedAt])
  @@index([poId])
  @@index([ticketId])
  @@index([createdById])
  @@index([receivedById])
  @@index([signedById])
  @@index([acknowledgedById])
  @@index([vehicleId, status])
}

model DeliveryOrderProof {
  id              String        @id @default(cuid()) @map("_id")
  deliveryOrderId String
  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  url             String        @unique
  createdAt       DateTime      @default(now())

  @@index([deliveryOrderId, createdAt])
}

model Vehicle {
  id                  String               @id @default(cuid()) @map("_id")
  plateNumber         String               @unique
  vehicleType         String
  brand               String?
  modelName           String?
  currentKilometer    BigInt               @default(0)
  odometerInitialized Boolean              @default(false)
  status              String               @default("AVAILABLE")
  deliveryOrders      DeliveryOrder[]      @relation("DeliveryOrderVehicle")
  tripLogs            VehicleTripLog[]
  fuelRequests        VehicleFuelRequest[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([status, plateNumber])
}

model VehicleTripLog {
  id                   String         @id @default(cuid()) @map("_id")
  vehicleId            String
  vehicle              Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  deliveryOrderId      String?        @unique
  deliveryOrder        DeliveryOrder? @relation(fields: [deliveryOrderId], references: [id], onDelete: SetNull)
  projectId            String?
  project              Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  kilometerStart       BigInt
  kilometerEnd         BigInt
  distanceKm           BigInt
  fuelLiter            BigInt
  fuelEfficiencyKmPerL BigInt         @default(12000)
  createdById          String
  createdBy            User           @relation("VehicleTripLogCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt            DateTime       @default(now())

  @@index([vehicleId, createdAt])
  @@index([projectId, createdAt])
  @@index([createdById, createdAt])
}

model VehicleFuelRequest {
  id                    String                   @id @default(cuid()) @map("_id")
  vehicleId             String
  vehicle               Vehicle                  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  deliveryOrderId       String
  deliveryOrder         DeliveryOrder            @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  projectId             String?
  project               Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  requestedById         String
  requestedBy           User                     @relation("VehicleFuelRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedById          String?
  reviewedBy            User?                    @relation("VehicleFuelReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  source                VehicleFuelSource
  estimatedDistanceKm   BigInt
  exceptionDistanceKm   BigInt                   @default(0)
  exceptionReason       String?
  estimatedFuelLiter    BigInt
  unitPrice             BigInt
  requestedAmount       BigInt
  fuelEfficiencyKmPerL  BigInt                   @default(12000)
  disbursementMethod    POPaymentMethod?
  transferDestination   String?
  transferProofUrl      String?
  beforeFillingPhotoUrl String
  afterFillingPhotoUrl  String?
  receiptPhotoUrl       String?
  status                VehicleFuelRequestStatus @default(PENDING_FINANCE)
  financeNote           String?
  reviewedAt            DateTime?
  disbursedAt           DateTime?
  proofSubmittedAt      DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([status, createdAt])
  @@index([vehicleId, createdAt])
  @@index([deliveryOrderId, status])
  @@index([requestedById, createdAt])
}

model POItem {
  id          String        @id @default(cuid()) @map("_id")
  poId        String
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  itemCode    String?
  stockItemId String?
  stockItem   StockItem?    @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  itemName    String
  quantity    Float
  unit        String
  unitPrice   Float
  totalPrice  Float
  ticketItems TicketItem[]

  @@index([poId])
  @@index([stockItemId])
}

model DOItem {
  id           String        @id @default(cuid()) @map("_id")
  doId         String
  do           DeliveryOrder @relation(fields: [doId], references: [id], onDelete: Cascade)
  itemCode     String?
  itemName     String
  qtyOrdered   Float
  qtyDelivered Float
  unit         String        @default("pcs")
  remarks      String?
  ticketItems  TicketItem[]

  @@index([doId])
}

model Invoice {
  id               String         @id @default(cuid()) @map("_id")
  publicCode       String?        @unique
  invoiceNumber    String?        @unique
  poId             String?
  po               PurchaseOrder? @relation(fields: [poId], references: [id], onDelete: SetNull)
  projectId        String?
  project          Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  subkonTermynId   String?        @unique
  subkonTermyn     SubkonTermyn?  @relation(fields: [subkonTermynId], references: [id], onDelete: SetNull)
  vendorName       String
  periodOrDate     String?
  paymentMethod    String?
  bankAccount      String?
  documentUrl      String?
  subTotal         Float
  tax              Float?
  deduction        Float?
  grandTotal       Float
  status           String         @default("UNPAID")
  signedById       String?
  signedBy         User?          @relation("InvoiceSigner", fields: [signedById], references: [id], onDelete: SetNull)
  signedAt         DateTime?
  acknowledgedById String?
  acknowledgedBy   User?          @relation("InvoiceAcknowledger", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  acknowledgedAt   DateTime?
  items            InvoiceItem[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([poId, status, createdAt])
  @@index([projectId, createdAt])
  @@index([signedById])
  @@index([acknowledgedById])
}

model InvoiceItem {
  id          String  @id @default(cuid()) @map("_id")
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemCode    String?
  description String
  quantity    Float
  unit        String
  unitPrice   Float
  totalPrice  Float

  @@index([invoiceId])
}

model FinanceAccount {
  id             String          @id @default(cuid()) @map("_id")
  accountName    String
  accountNumber  String?
  holderName     String
  balance        Float           @default(0)
  transactions   Cashflow[]
  officeExpenses OfficeExpense[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Cashflow {
  id                   String              @id @default(cuid()) @map("_id")
  type                 String
  amount               Float
  sourceDesc           String
  projectId            String?
  project              Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  paymentMethod        String
  senderName           String?
  proofUrl             String?
  accountId            String
  account              FinanceAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  recordedBy           String
  recorder             User                @relation("CashflowRecorder", fields: [recordedBy], references: [id], onDelete: Restrict)
  transferGroupId      String?
  paymentTransactionId String?             @unique
  paymentTransaction   PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)
  officeExpense        OfficeExpense?
  createdAt            DateTime            @default(now())

  @@index([accountId, createdAt])
  @@index([projectId, createdAt])
  @@index([transferGroupId])
}

model OfficeExpense {
  id            String         @id @default(cuid()) @map("_id")
  expenseType   String
  description   String
  amount        Float
  recipientId   String
  recipient     User           @relation("OfficeExpenseRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  accountId     String
  account       FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  paymentMethod String
  proofUrls     String[]
  recordedBy    String
  recorder      User           @relation("OfficeExpenseRecorder", fields: [recordedBy], references: [id], onDelete: Restrict)
  cashflowId    String         @unique
  cashflow      Cashflow       @relation(fields: [cashflowId], references: [id], onDelete: Restrict)
  createdAt     DateTime       @default(now())

  @@index([recipientId, createdAt])
  @@index([accountId, createdAt])
}

model OrderConfirmation {
  id                   String              @id @default(cuid()) @map("_id")
  publicCode           String?             @unique
  koNumber             String              @unique
  poId                 String
  po                   PurchaseOrder       @relation(fields: [poId], references: [id], onDelete: Cascade)
  paymentTransactionId String?             @unique
  paymentTransaction   PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)
  estDelivery          String?
  paymentTerms         String?
  paymentType          String?
  paymentAmount        Float?
  transferDestination  String?
  proofOfTransferUrl   String?
  paidAt               DateTime?
  vendorSentAt         DateTime?
  vendorSentById       String?
  vendorSentBy         User?               @relation("OrderConfirmationVendorSender", fields: [vendorSentById], references: [id], onDelete: SetNull)
  signedById           String?
  signedBy             User?               @relation("OrderConfirmationSigner", fields: [signedById], references: [id], onDelete: SetNull)
  signedAt             DateTime?
  acknowledgedById     String?
  acknowledgedBy       User?               @relation("OrderConfirmationAcknowledger", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  acknowledgedAt       DateTime?
  subTotal             Float
  tax                  Float?
  grandTotal           Float
  items                KOItem[]
  createdAt            DateTime            @default(now())

  @@index([poId, createdAt])
  @@index([vendorSentAt, createdAt])
  @@index([signedById])
  @@index([acknowledgedById])
}

model KOItem {
  id          String            @id @default(cuid()) @map("_id")
  koId        String
  ko          OrderConfirmation @relation(fields: [koId], references: [id], onDelete: Cascade)
  itemCode    String?
  description String
  quantity    Float
  unit        String
  unitPrice   Float
  totalPrice  Float

  @@index([koId])
}

model IssuedDocument {
  id              String           @id @default(cuid()) @map("_id")
  documentNumber  String           @unique
  templateId      String
  template        DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  relatedRecordId String?
  issuedById      String
  issuer          User             @relation("IssuedDocumentIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  status          String           @default("VALID")
  createdAt       DateTime         @default(now())

  @@index([templateId, createdAt])
  @@index([issuedById, createdAt])
}

model OperationalDocument {
  id             String                       @id @default(cuid()) @map("_id")
  documentNumber String                       @unique
  kind           OperationalDocumentKind
  status         OperationalDocumentStatus    @default(SIGNED)
  title          String
  content        String
  signatureImage String
  signerName     String
  signerRole     UserRole
  signedAt       DateTime                     @default(now())
  preparedById   String
  preparedBy     User                         @relation("OperationalDocumentPreparer", fields: [preparedById], references: [id], onDelete: Restrict)
  signedById     String
  signedBy       User                         @relation("OperationalDocumentSigner", fields: [signedById], references: [id], onDelete: Restrict)
  issuedById     String?
  issuedBy       User?                        @relation("OperationalDocumentIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  issuedAt       DateTime?
  ticketId       String
  ticket         Ticket                       @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  templateId     String?
  template       OperationalDocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdAt      DateTime                     @default(now())

  @@index([ticketId, status])
  @@index([kind, status])
  @@index([preparedById, createdAt])
  @@index([issuedById, issuedAt])
}

model TicketItem {
  id                   String             @id @default(cuid()) @map("_id")
  ticketId             String
  ticket               Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  itemName             String
  quantity             Float
  unit                 String
  estimatedCost        BigInt?
  categoryHint         TicketCategoryHint @default(WAREHOUSE)
  expectedDeliveryDate DateTime?
  status               FulfillmentStatus  @default(PENDING)
  poItemId             String?
  poItem               POItem?            @relation(fields: [poItemId], references: [id], onDelete: SetNull)
  doItemId             String?
  doItem               DOItem?            @relation(fields: [doItemId], references: [id], onDelete: SetNull)

  @@index([ticketId, status])
  @@index([poItemId])
  @@index([doItemId])
}

model TicketAuditLog {
  id        String   @id @default(cuid()) @map("_id")
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  action    String
  notes     String?
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@index([userId])
}
